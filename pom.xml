<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		LEGACY BASELINE: Spring Boot 2.7.18 is the final 2.x release.
		Open-source support for 2.7 ended in 2023, so this stack no longer
		receives public security fixes. That is deliberate: this project
		starts on an end-of-life stack and migrates forward.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.18</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>dev.razzi</groupId>
	<artifactId>watchlist-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>watchlist-api</name>
	<description>Options watchlist API - EOL migration demo</description>

	<properties>
		<!-- Compile to Java 11 bytecode, like a typical 2.7-era codebase. -->
		<java.version>11</java.version>

		<!--
			TACTICAL PATCH (no framework upgrade). spring-boot-starter-parent
			exposes each managed library's version as a property; overriding it
			pulls a newer patch release of the same line. Only same-line bumps
			here, so behavior shouldn't change. See docs/security/ for before/after.
			  - Tomcat 9.0.x is still maintained by Apache: 9.0.83 -> 9.0.121
			  - Spring Framework 5.3.39 is the LAST free 5.3 release; later 5.3.x
			    fixes (e.g. 5.3.42) are commercial-only and not on Maven Central.
			  - Logback 1.2.13 is the last 1.2.x fix.
		-->
		<tomcat.version>9.0.121</tomcat.version>
		<spring-framework.version>5.3.39</spring-framework.version>
		<logback.version>1.2.13</logback.version>
	</properties>

	<dependencies>
		<!-- REST controllers, embedded Tomcat, Jackson JSON -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Spring Data JPA + Hibernate 5 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Bean Validation (javax.validation in the 2.x era) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- In-memory database, only needed at runtime -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JUnit 5, Mockito, AssertJ, Spring test slices -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				Software Bill of Materials (SBOM): an inventory of every library
				that ships in the jar, including transitive ones, with exact
				versions and package URLs (purls). Written to target/bom.json
				during "package". Security scanners consume this file.
			-->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<version>2.9.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>makeAggregateBom</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<outputFormat>json</outputFormat>
					<outputName>bom</outputName>
					<!-- Only what ships to production; test libraries are excluded. -->
					<includeTestScope>false</includeTestScope>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Windows-only workaround. Since JDK 16, Java NIO on Windows wakes its
			selector through a Unix-domain socket created in the temp directory.
			If that path is an 8.3 short name or contains spaces (e.g. a user
			folder like "C:\Users\Custom Desktop"), Tomcat fails to start with
			"Unable to establish loopback connection". Point the socket at a
			space-free directory. The profile activates automatically on Windows
			and has no effect on Linux/macOS or in CI.
		-->
		<profile>
			<id>windows-uds-workaround</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<uds.tmpdir>${env.PUBLIC}</uds.tmpdir>
				<!-- Picked up by the Surefire test runner's forked JVM. -->
				<argLine>-Djdk.net.unixdomain.tmpdir=${uds.tmpdir}</argLine>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<!-- Same fix for "mvnw spring-boot:run". -->
							<jvmArguments>-Djdk.net.unixdomain.tmpdir=${uds.tmpdir}</jvmArguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
