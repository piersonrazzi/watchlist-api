<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		Migration history (see docs/MIGRATION.md):
		  v0.1  Spring Boot 2.7.18 / Java 11  (free support ended 2023-06-30)
		  v0.2  2.7.18 + in-line security patches
		  v0.3  Spring Boot 3.5.16 / Java 21  (free support ended 2026-06-30)
		  v1.0  Spring Boot 4.1.1  / Java 21  (free support until 2027-07-31)
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>dev.razzi</groupId>
	<artifactId>watchlist-api</artifactId>
	<version>1.0.0</version>
	<name>watchlist-api</name>
	<description>Options watchlist REST API, migrated from end-of-life Spring Boot 2.7 to 4.1</description>

	<properties>
		<!-- Java 21 is the current LTS (Boot 4.1 supports 17-26). -->
		<java.version>21</java.version>
		<!-- Extra JVM flags for the test JVM; the Windows profile below fills this in. -->
		<argLine></argLine>

		<!--
			TEMPORARY SECURITY OVERRIDE (added 2026-09-23)
			Boot 4.1.1 ships Tomcat 11.0.24, which has 3 critical advisories
			(CVE-2026-65182, CVE-2026-65905, CVE-2026-68525) fixed in 11.0.25.
			No Boot release includes the fix yet, so we pin the latest 11.0.x patch.
			Same line (11.0.x) = drop-in; all tests pass.
			Triage: all three affect Tomcat's DIGEST/FORM auth and access-control
			features, which this app doesn't use, but policy is zero known criticals.
			EXIT PLAN: delete this property when upgrading to a Boot release that
			manages Tomcat >= 11.0.25 (Dependabot will open that PR). Leftover
			overrides are what broke the 3.5 migration; see docs/MIGRATION.md.
		-->
		<tomcat.version>11.0.26</tomcat.version>
	</properties>

	<!--
		Boot 4 is modular: instead of one big autoconfigure jar, each technology
		has its own module and starter. "starter-web" is now "starter-webmvc", and
		the single "starter-test" is split into per-technology test starters that
		bring only the test slices you use (@WebMvcTest, @DataJpaTest...).
	-->
	<dependencies>
		<!-- Spring MVC REST controllers, embedded Tomcat, JSON -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Spring Data JPA + Hibernate 7 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Bean Validation (jakarta.validation) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- In-memory database, only needed at runtime -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Test starters: JUnit, Mockito, AssertJ + the matching Spring test slice -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
				Software Bill of Materials (SBOM): an inventory of every library
				that ships in the jar, including transitive ones, with exact
				versions and package URLs (purls). Security scanners consume it.

				Since Boot 3.3 the parent POM pre-configures this plugin (version,
				goal, phase, output path), so declaring it is enough. The SBOM is
				written to target/classes/META-INF/sbom/application.cdx.json and
				therefore ships INSIDE the jar. Test-scope libraries are excluded.
				(In the Boot 2.7 version we configured all of this by hand and wrote
				target/bom.json; after upgrading, that stale file fooled the scanner.)
			-->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>

			<!--
				Load Mockito as a Java agent at JVM startup. Otherwise Mockito
				"self-attaches" at runtime, which JDK 21 warns about (JEP 451) and a
				future JDK will block. The "properties" goal exposes each dependency's
				jar path as a Maven property, e.g. ${org.mockito:mockito-core:jar}.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						@{argLine} is evaluated late, so it includes whatever the Windows
						profile adds. The agent path is quoted because the local Maven
						repository can live under a folder with a space in its name.
					-->
					<argLine>@{argLine} "-javaagent:${org.mockito:mockito-core:jar}"</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Windows-only workaround. Since JDK 16, Java NIO on Windows wakes its
			selector through a Unix-domain socket created in the temp directory.
			If that path is an 8.3 short name or contains spaces (e.g. a user
			folder like "C:\Users\Custom Desktop"), Tomcat fails to start with
			"Unable to establish loopback connection". Point the socket at a
			space-free directory. The profile activates automatically on Windows
			and has no effect on Linux/macOS or in CI.
		-->
		<profile>
			<id>windows-uds-workaround</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<uds.tmpdir>${env.PUBLIC}</uds.tmpdir>
				<!-- Picked up by the Surefire test runner's forked JVM. -->
				<argLine>-Djdk.net.unixdomain.tmpdir=${uds.tmpdir}</argLine>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<!-- Same fix for "mvnw spring-boot:run". -->
							<jvmArguments>-Djdk.net.unixdomain.tmpdir=${uds.tmpdir}</jvmArguments>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
